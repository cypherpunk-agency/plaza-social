{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:deploy": "node scripts/build-with-redirect.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:dist": "npx serve dist",
    "test:host": "playwright test --config playwright.config.ts",
    "test:host:plaza": "playwright test --config playwright.config.ts 10-plaza-in-host 11-plaza-screenshots 12-product-account",
    "test:host:screens": "playwright test --config playwright.config.ts 11-plaza-screenshots",
    "test:host:probe": "vite --config tests/fixture-app/vite.config.ts",
    "test:lib": "node --experimental-strip-types --test src/lib/*.test.ts"
  },
  "dependencies": {
    "@parity/product-sdk": "^0.19.1",
    "@parity/product-sdk-address": "^0.1.1",
    "@parity/product-sdk-chain-client": "^0.9.1",
    "@parity/product-sdk-cloud-storage": "^0.8.1",
    "@parity/product-sdk-contracts": "^0.9.2",
    "@parity/product-sdk-descriptors": "^0.8.0",
    "@parity/product-sdk-host": "^0.14.1",
    "@parity/product-sdk-keys": "^0.3.16",
    "@parity/product-sdk-statement-store": "^0.6.2",
    "@parity/product-sdk-tx": "^0.3.2",
    "@parity/result": "^0.2.0",
    "@parity/truapi": "^0.5.1",
    "ethers": "^6.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hot-toast": "^2.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@parity/host-api-test-sdk": "^0.11.0",
    "@playwright/test": "^1.62.0",
    "@polkadot-api/substrate-bindings": "^0.12.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
